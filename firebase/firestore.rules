rules_version = '2';

// ===========================================================================
//  Règles de sécurité Firestore — plateforme du Master S2I (ENSIAS)
//  Projet Firebase : master-s2i (site Hosting associé : ensias-master-s2i)
//
//  Principe : chaque compte Firebase Authentication possède un profil
//  users/{uid} = { role: "admin" | "prof" | "student", refId, section, email }
//    - refId   : identifiant du document profs/{id} ou students/{id}
//    - section : "TN-1A", "TAM-1A", "TN-2A" ou "TAM-2A" (étudiants)
//  Seul l'administrateur crée et modifie ces profils.
// ===========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me()         { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role()       { return hasProfile() ? me().role : ""; }
    function isAdmin()    { return role() == "admin"; }
    function isProf()     { return role() == "prof"; }
    function isStudent()  { return role() == "student"; }
    function isStaff()    { return isAdmin() || isProf(); }
    function profModules(){ return get(/databases/$(database)/documents/profs/$(me().refId)).data.modules; }

    // Profils de connexion (rôles)
    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      // Amorçage : seul le compte du coordinateur peut se déclarer administrateur
      allow create: if signedIn() && request.auth.uid == uid
                    && request.auth.token.email in ["aissam.berrahou@gmail.com", "aissam.berrahou@ensias.um5.ac.ma"]
                    && request.resource.data.role == "admin";
    }

    // Paramètres généraux (année, sections, modèles d'e-mails…)
    // config/ia (clé du service d'IA) : enseignants et administration seulement
    match /config/{doc} {
      allow read:  if (signedIn() && doc != "ia") || isStaff();
      allow write: if isAdmin();
    }

    // Programme de la formation : public (page d'accueil)
    match /modules/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /promotions/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    match /profs/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // Un étudiant ne lit que sa propre fiche
    match /students/{id} {
      allow read:  if isStaff() || (isStudent() && me().refId == id);
      allow write: if isAdmin();
    }

    match /timetable/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    match /exams/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    match /soutenances/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // Notifications ciblées (le filtrage formation / promotion / date se fait dans le site)
    match /notifications/{id} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // Contenus pédagogiques : l'étudiant ne lit que les contenus publiés (le site filtre par section) ;
    // le prof ne gère que ses contenus, dans ses modules.
    match /contents/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.statut == "publie");
      allow create: if isAdmin()
                  || (isProf() && request.resource.data.profId == me().refId && request.resource.data.module in profModules());
      allow update: if isAdmin()
                  || (isProf() && resource.data.profId == me().refId && request.resource.data.profId == me().refId
                      && request.resource.data.module in profModules());
      allow delete: if isAdmin() || (isProf() && resource.data.profId == me().refId);
    }

    // Documents des contenus (fiche) : rubrique Cours / TP / TD / Mise à niveau, sous-dossier, nom, taille…
    // Le statut du contenu est recopié sur chaque document : l'étudiant ne lit que les documents publiés.
    match /fichiers/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.statut == "publie");
      allow create, update: if isAdmin()
                  || (isProf() && request.resource.data.profId == me().refId && request.resource.data.module in profModules());
      allow delete: if isAdmin() || (isProf() && resource.data.profId == me().refId);
    }

    // Contenu des documents, découpé en morceaux de moins de 1 Mo (identifiants aléatoires « <idFichier>_<n> »).
    // Lecture d'un morceau par son identifiant uniquement (pas de liste pour les étudiants).
    match /fichiers_data/{id} {
      allow get:    if signedIn();
      allow list:   if isStaff();
      allow create: if isStaff() && request.resource.data.data is string && request.resource.data.data.size() <= 950000;
      allow update: if false;
      allow delete: if isStaff();
    }

    // Quiz : l'étudiant lit les quiz publiés ou fermés (sans les bonnes réponses, rangées dans quiz_corriges)
    function quizOf(qid) { return get(/databases/$(database)/documents/quiz/$(qid)).data; }
    match /quiz/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.statut in ["publie", "ferme"]);
      allow create, update: if isAdmin()
                  || (isProf() && request.resource.data.profId == me().refId && request.resource.data.module in profModules());
      allow delete: if isAdmin() || (isProf() && resource.data.profId == me().refId);
    }

    // Bonnes réponses et explications : visibles par l'étudiant seulement après la fermeture du quiz,
    // ou (correction immédiate) une fois sa dernière tentative rendue.
    match /quiz_corriges/{qid} {
      allow read: if isStaff()
                  || (isStudent() && (quizOf(qid).statut == "ferme"
                      || (quizOf(qid).fermetureMs > 0 && request.time.toMillis() > quizOf(qid).fermetureMs)
                      || (quizOf(qid).corrige == "immediat" && quizOf(qid).tentatives == 0
                          && exists(/databases/$(database)/documents/quiz_reponses/$(qid + "_" + me().refId + "_1")))
                      || (quizOf(qid).corrige == "immediat" && quizOf(qid).tentatives > 0
                          && exists(/databases/$(database)/documents/quiz_reponses/$(qid + "_" + me().refId + "_" + string(quizOf(qid).tentatives))))));
      allow create, update: if isAdmin()
                  || (isProf() && request.resource.data.profId == me().refId && request.resource.data.module in profModules());
      allow delete: if isAdmin() || (isProf() && resource.data.profId == me().refId);
    }

    // Copies des étudiants : une copie par tentative (identifiant quiz_étudiant_n), non modifiable,
    // déposée uniquement pendant l'ouverture du quiz et dans la limite des tentatives.
    match /quiz_reponses/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.studentId == me().refId);
      allow create: if isStudent() && request.resource.data.studentId == me().refId
                    && id == request.resource.data.quizId + "_" + me().refId + "_" + string(request.resource.data.tentative)
                    && quizOf(request.resource.data.quizId).statut == "publie"
                    && me().section in quizOf(request.resource.data.quizId).sections
                    && (quizOf(request.resource.data.quizId).tentatives == 0 || request.resource.data.tentative <= quizOf(request.resource.data.quizId).tentatives)
                    && (quizOf(request.resource.data.quizId).fermetureMs == 0 || request.time.toMillis() <= quizOf(request.resource.data.quizId).fermetureMs + 180000);
      allow update: if false;
      allow delete: if isStaff();
    }

    // Séances à distance (Microsoft Teams) : lisibles par tous les comptes connectés (le site filtre par section) ;
    // le prof ne gère que ses séances, dans ses modules.
    match /visios/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
                  || (isProf() && request.resource.data.profId == me().refId && request.resource.data.module in profModules());
      allow update: if isAdmin()
                  || (isProf() && resource.data.profId == me().refId && request.resource.data.profId == me().refId
                      && request.resource.data.module in profModules());
      allow delete: if isAdmin() || (isProf() && resource.data.profId == me().refId);
    }

    // Feuilles de présence : l'étudiant lit les séances de sa section ; le prof gère les siennes.
    match /sessions/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.section == me().section);
      allow create: if isAdmin() || (isProf() && request.resource.data.profId == me().refId);
      allow update: if isAdmin()
                  || (isProf() && resource.data.profId == me().refId && request.resource.data.profId == me().refId);
      allow delete: if isAdmin() || (isProf() && resource.data.profId == me().refId);
    }

    // Rappels de saisie des absences : créés par l'administrateur, lus par l'enseignant concerné.
    match /rappels/{id} {
      allow read: if isAdmin() || (isProf() && resource.data.profId == me().refId);
      allow create, update, delete: if isAdmin();
    }

    // Journal d'activité : chaque compte n'écrit que ses propres entrées (rôle vérifié) ;
    // seul l'administrateur peut le consulter ou le purger. Aucune modification possible.
    match /logs/{id} {
      allow read, delete: if isAdmin();
      allow create: if hasProfile() && request.resource.data.uid == request.auth.uid && request.resource.data.role == role();
      allow update: if false;
    }

    // Messagerie par module et section
    match /messages/{id} {
      allow read: if isStaff()
                  || (isStudent() && (resource.data.section == me().section || resource.data.section == "ALL"));
      allow create: if isAdmin()
                  || (hasProfile() && request.resource.data.authorUid == request.auth.uid
                      && (isProf() || (isStudent() && request.resource.data.section == me().section && request.resource.data.module != "ALL")));
      allow update, delete: if isAdmin();
    }
  }
}
